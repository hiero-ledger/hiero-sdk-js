# Hiero SDK JS - Local Development Environment Configuration
# Copy this file to .env and update with your local values
# Run ./scripts/solo-setup.js to automatically generate .env with proper values
# Install Solo globally first: npm install -g @hashgraph/solo@latest

# Network Configuration
# Options: local-node, testnet, previewnet, mainnet
HEDERA_NETWORK=local-node

# Optional CLPR integration tests on the single configured network.
# Leave CLPR_ENABLED unset to skip all CLPR tests with a printed reason.
# CLPR_ENABLED=true runs queries, registrations and non-admin authorization checks.
# The node must have clpr.enabled=true, and OPERATOR_ID must be funded and non-admin.
# CLPR_ENABLED=false checks CLPR_NOT_ENABLED on a node with clpr.enabled=false.
# CLPR_ENABLED=

# Optional: Path to a configuration file
# CONFIG_FILE=

# Standard Test Account (ECDSA) - Use this for most integration tests
# These values will be automatically generated by solo-setup.js
OPERATOR_ID=0.0.1001
OPERATOR_KEY=302e020100300506032b657004220420your-private-key-here

# Genesis Account - Only use for genesis-specific tests
# Default Solo genesis account (DO NOT use for regular tests)
GENESIS_OPERATOR_ID=0.0.2
GENESIS_OPERATOR_KEY=302e020100300506032b65700422042091132178e72057a1d7528025956fe39b0b847f200ab59b2fdd367017f3087137

# Node Endpoints
NODE1_ENDPOINT=127.0.0.1:50211
NODE2_ENDPOINT=127.0.0.1:51211

# Mirror Node Endpoints
MIRROR_REST_ENDPOINT=http://localhost:5551
MIRROR_WEB3_ENDPOINT=http://localhost:8545
MIRROR_GRPC_ENDPOINT=localhost:5600

# CLPR examples are excluded from run-all-examples.js. Run them explicitly.
# The two free query examples need only HEDERA_NETWORK and node endpoints.
# Lifecycle and update examples also use the account keys documented above.
# Channel ID: exactly 64 hex characters, without 0x.
# CLPR_CHANNEL_ID=
# Ownership private key in DER hex, for Channel or Connector completion.
# CLPR_OWNERSHIP_KEY=
# Deployed verifier ContractId and real binary peer-ledger proof files.
# CLPR_VERIFIER_CONTRACT_ID=
# CLPR_CONFIG_PROOF_FILE=
# CLPR_MANIFEST_PROOF_FILE=
# Deployed Connector ContractId, administrative private key in DER hex, and stake.
# The stake must meet the node's clpr.minLockedStake, in decimal tinybars.
# CLPR_CONNECTOR_CONTRACT_ID=
# CLPR_CONNECTOR_ADMIN_KEY=
# CLPR_LOCKED_STAKE_TINYBARS=
# Positive uint32 limit to change in the read-modify-write throttle example.
# CLPR_MAX_MESSAGES_PER_BUNDLE=
