# Variable used in script that runs all examples
NODE_COMMAND=node

# Optional: endpoints of a local network on other ports than the `local-node`
# defaults, which are Solo's 127.0.0.1:35211 (consensus node) and
# 127.0.0.1:38081 (mirror node ingress). Unset or empty keeps the default.
# See manual/CONFIGURATION.md for the precedence rules.
# NODE_IP="127.0.0.1:50211"
# NODE_ACCOUNT_ID="0.0.3"
# MIRROR_NETWORK="127.0.0.1:5600"
# MIRROR_NODE_REST_URL="http://127.0.0.1:38081"
