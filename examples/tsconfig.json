{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": ["ESNext"],
        "allowJs": true,
        "checkJs": true,
        "emitDeclarationOnly": false,
        "declaration": false,
        "strict": true,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "downlevelIteration": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        // Generated Long declarations fail lib checks, see https://github.com/hiero-ledger/hiero-sdk-js/issues/4373
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": ["*.js", "*.json", "*/*.js"],
    "exclude": ["demo-umd"]
}
