# The operator is responsible for paying transaction and query fees
#
# The `LocalWallet` uses the environment variables `OPERATOR_ID`, `OPERATOR_KEY`,
# and `HEDERA_NETWORK`

# Hedera Operator Account ID
OPERATOR_ID="0.0.2336"

# Hedera Operator Private Key
OPERATOR_KEY="302e020100300506032b6570042204202cc589a6343ff8d05b71edf54f69bff4cd8faeec9b04d16f55d1d78fe23841af"

# Hedera Network
# Options:
#   - previewnet: Connects to the Hedera preview network.
#   - local-node: Connects to a local Hedera node for development/testing.
HEDERA_NETWORK="previewnet"

# Optional: endpoints of a local network whose ports differ from the
# `local-node` defaults (a Solo deployment, say). Unset or empty keeps the
# default. See manual/CONFIGURATION.md for the precedence rules.
# NODE_IP="127.0.0.1:35211"
# NODE_WEB_IP="127.0.0.1:38090"
# NODE_ACCOUNT_ID="0.0.3"
# MIRROR_NETWORK="127.0.0.1:35600"
# MIRROR_NODE_REST_URL="http://127.0.0.1:38081"
