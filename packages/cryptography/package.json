{
    "name": "@hiero-ledger/cryptography",
    "version": "1.23.0",
    "description": "Cryptographic utilities and primitives for the Hiero SDK",
    "main": "./lib/index.cjs",
    "types": "./lib/index.d.ts",
    "module": "./src/index.js",
    "react-native": {
        "./lib/index.cjs": "./src/index.native.js"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "react-native": "./src/index.native.js",
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./src/index.js"
            },
            "require": {
                "types": "./lib/index.d.cts",
                "default": "./lib/index.cjs"
            }
        }
    },
    "license": "Apache-2.0",
    "author": "Launchbadge <contact@launchbadge.com>",
    "repository": "https://github.com/hiero-ledger/hiero-sdk-js",
    "bugs": "https://github.com/hiero-ledger/hiero-sdk-js/issues",
    "type": "module",
    "sideEffects": false,
    "keywords": [
        "hiero",
        "sdk",
        "hedera",
        "hashgraph",
        "cryptography"
    ],
    "files": [
        "lib/",
        "src/"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "browserslist": [
        "last 1 Chrome versions",
        "last 1 Firefox versions"
    ],
    "dependencies": {
        "@noble/ciphers": "2.2.0",
        "@noble/curves": "2.2.0",
        "@noble/hashes": "2.2.0",
        "@scure/base": "2.2.0",
        "@scure/bip32": "2.2.0",
        "asn1js": "4.0.0",
        "bignumber.js": "11.1.2",
        "forge-light": "1.1.4"
    },
    "peerDependenciesMeta": {
        "expo-crypto": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/compat": "2.0.2",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "10.0.1",
        "@types/node": "26.1.1",
        "@typescript-eslint/eslint-plugin": "8.71.1",
        "@typescript-eslint/parser": "8.71.1",
        "@vitest/browser": "5.0.5",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-istanbul": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "c8": "12.0.0",
        "chromedriver": "154.0.0",
        "codecov": "3.8.3",
        "dpdm": "4.2.0",
        "esbuild": "0.28.1",
        "eslint": "10.12.0",
        "eslint-plugin-compat": "7.0.2",
        "eslint-plugin-import": "2.31.0",
        "eslint-plugin-jsdoc": "64.5.4",
        "eslint-plugin-n": "18.0.1",
        "@vitest/eslint-plugin": "1.6.7",
        "geckodriver": "7.0.0",
        "globals": "17.3.0",
        "npm-run-all": "4.1.5",
        "npx": "10.2.2",
        "prettier": "3.5.3",
        "typescript": "5.9.3",
        "vite": "7.3.7",
        "vitest": "5.0.5"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
